# Supabase (Plano Gratuito / Free Tier)
# Obtenha em: https://supabase.com -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Google AI Studio (Google Gemini 1.5 Flash - Gratuito sem cartão)
# Obtenha em: https://aistudio.google.com/ -> Get API key
GEMINI_API_KEY=your_gemini_api_key_here

# Backend Local URL (FastAPI)
VITE_API_URL=http://localhost:8000
